# 夜櫻：一棵遞迴生成的櫻花樹在風中搖曳，花瓣隨風飄落。整個草稿以星泉的繁體中文關鍵字與 Processing 中文別名寫成。
# Night Sakura: a recursive cherry tree sways in the wind and sheds petals, written with AquariusLang's 繁體中文 keywords
# and Processing's Chinese member names. In the spirit of OpenProcessing's fractal tree sketches.
變數 繪 = 匯入("Processing");
變數 陣列 = 匯入("陣列");
變數 title = "Night Sakura";
變數 titleZh = "夜櫻";
變數 idea = "遞迴樹 · recursive tree written in 繁體中文 keywords";
變數 renderer = 2;

變數 寬 = 0.0d;
變數 高 = 0.0d;
變數 花瓣橫 = [];
變數 花瓣縱 = [];
變數 花瓣速 = [];
變數 花瓣角 = [];
變數 花朵橫 = [];
變數 花朵縱 = [];
變數 已模擬 = 0;

變數 setup = 函式(g) {
    寬 = g.width * 1.0d;
    高 = g.height * 1.0d;
    花瓣橫 = []; 花瓣縱 = []; 花瓣速 = []; 花瓣角 = [];
    已模擬 = 0;
    繪.亂數種子(4);
    迴圈 (變數 i = 0; i < 260; i++) {
        陣列.追加(花瓣橫, 繪.亂數(寬));
        陣列.追加(花瓣縱, 繪.亂數(高));
        陣列.追加(花瓣速, 繪.亂數(0.6d, 1.6d));
        陣列.追加(花瓣角, 繪.亂數(繪.TWO_PI));
    }
};

# 一根枝條：畫線、平移到末端，再長出兩根較短的枝條；最末端記下花朵位置（以螢幕座標）。
變數 枝 = 函式(g, 長, 深, 風) {
    g.描邊粗細(深 * 1.15d + 0.6d);
    g.描邊(70 + 深 * 6, 42 + 深 * 3, 60 + 深 * 4);
    g.線段(0, 0, 0, -長);
    g.平移(0, -長);
    如果 (深 <= 1) {
        陣列.追加(花朵橫, g.screenX(0, 0));
        陣列.追加(花朵縱, g.screenY(0, 0));
        回傳 0;
    }
    變數 張角 = 0.32d + 繪.亂數(0.18d);
    變數 擺動 = 風 * (11 - 深) * 0.012d;
    g.推入矩陣();
    g.旋轉(-張角 + 擺動);
    枝(g, 長 * 繪.亂數(0.68d, 0.8d), 深 - 1, 風);
    g.彈出矩陣();
    g.推入矩陣();
    g.旋轉(張角 * 0.8d + 擺動);
    枝(g, 長 * 繪.亂數(0.66d, 0.8d), 深 - 1, 風);
    g.彈出矩陣();
    回傳 0;
};

變數 draw = 函式(g, t) {
    # 夜空漸層與月亮。
    g.停用描邊();
    迴圈 (變數 y = 0; y < 高; y += 8) {
        變數 k = y / 高;
        g.填色(10 + k * 40, 12 + k * 18, 40 + k * 30);
        g.矩形(0, y, 寬, 8);
    }
    g.填色(255, 240, 220, 30);
    g.圓形(寬 * 0.78d, 高 * 0.2d, 190);
    g.填色(255, 246, 230);
    g.圓形(寬 * 0.78d, 高 * 0.2d, 110);
    # 樹：每格以相同種子重新生長，所以形狀固定，只有風在變。
    變數 風 = 繪.正弦(t * 0.9d) * 0.6d + 繪.雜訊(t * 0.4d) * 0.8d - 0.4d;
    花朵橫 = [];
    花朵縱 = [];
    繪.亂數種子(7);
    g.推入矩陣();
    g.平移(寬 * 0.42d, 高 + 10);
    枝(g, 高 * 0.21d, 10, 風);
    g.彈出矩陣();
    # 花朵：加色混合的柔光。
    g.混色模式(繪.ADD);
    g.停用描邊();
    迴圈 (變數 i = 0; i < 長度(花朵橫); i++) {
        g.填色(255, 120, 170, 34);
        g.圓形(花朵橫[i], 花朵縱[i], 26);
        g.填色(255, 200, 225, 120);
        g.圓形(花朵橫[i], 花朵縱[i], 7);
    }
    g.混色模式(繪.BLEND);
    # 花瓣：隨風飄落，落到地面後從樹冠重新出現。
    變數 目標 = 繪.floor(t * 60);
    迴圈 (變數 步 = 已模擬; 步 < 目標; 步++) {
        迴圈 (變數 i = 0; i < 長度(花瓣橫); i++) {
            花瓣橫[i] = 花瓣橫[i] + 風 * 1.6d + 繪.正弦(花瓣角[i]) * 0.6d + 0.5d;
            花瓣縱[i] = 花瓣縱[i] + 花瓣速[i];
            花瓣角[i] = 花瓣角[i] + 0.03d;
            如果 (花瓣縱[i] > 高 + 10 || 花瓣橫[i] > 寬 + 10) {
                變數 來源 = 繪.floor(繪.亂數(長度(花朵橫)));
                花瓣橫[i] = 花朵橫[來源];
                花瓣縱[i] = 花朵縱[來源];
            }
        }
    }
    已模擬 = 目標;
    迴圈 (變數 i = 0; i < 長度(花瓣橫); i++) {
        g.推入矩陣();
        g.平移(花瓣橫[i], 花瓣縱[i]);
        g.旋轉(花瓣角[i]);
        g.填色(255, 170, 200, 220);
        g.橢圓(0, 0, 9, 5 + 繪.正弦(花瓣角[i] * 2) * 2);
        g.彈出矩陣();
    }
};
